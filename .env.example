# =============================================================================
# Solventa POC — Experimento 1
# Graceful degradation de la cotización embebida ante indisponibilidad
# del proveedor de Open Finance (ASR-Disp-09).
#
# Copiar a .env:  cp .env.example .env
#
# REGLA RECTORA (kickoff §0): todo parámetro de este archivo es la variable
# independiente de algún punto de sensibilidad, o una variable de control que
# ese SP necesita fijar. No agregar flags que no sirvan a ningún SP.
# =============================================================================


# =============================================================================
# 1. VARIABLES INDEPENDIENTES — lo que cada sub-experimento hace variar
# =============================================================================

# --- SP-1: timeout de Perfilamiento hacia Open Finance -----------------------
# Dónde se corta la espera a una dependencia externa no controlable.
# Trade-off: bajo protege la latencia pero descarta respuestas válidas y
# degrada el pricing; alto conserva precisión pero consume el presupuesto del
# journey y satura workers.
OPENFINANCE_TIMEOUT_MS=700               # contrastar: 400 | 700 | 1000

# --- SP-2: umbral de apertura y ventana half-open del circuit breaker --------
# Cuántas peticiones pagan el costo completo del fallo antes de que abra, y con
# qué rapidez recupera precisión sin oscilar (flapping).
BREAKER_FAIL_MAX=5                       # 3 | 5 | 10
BREAKER_RESET_TIMEOUT_S=30               # 10 | 30 | 60
BREAKER_ENABLED=true                     # ablación: false = sin breaker

# --- SP-3: TTL de la caché de perfil y comportamiento ante caché fría --------
# Cobertura de degradación vs. antigüedad del dato financiero servido.
PROFILE_CACHE_TTL_S=300                  # 60 | 300 | 900
PROFILE_CACHE_STALE_GRACE_S=1800         # 0 | 600 | 1800
CACHE_ENABLED=true                       # ablación: false = sin caché
CACHE_PRELOAD_RATIO=0.5                  # 0.0 (caché fría) | 0.5 | 1.0

# --- SP-4: fuente de verdad de la detección ---------------------------------
# Monitor proactivo (Ping-Echo sobre /health) vs. conteo reactivo del breaker
# sobre tráfico real. El /health del mock miente en los modos slow y flaky:
# ese punto ciego es el hallazgo que SP-4 debe producir.
MONITOR_SIGNAL_ENABLED=true              # false = solo detección reactiva del breaker
MONITOR_INTERVAL_MS=2000                 # 1000 | 2000 | 5000
MONITOR_UNHEALTHY_THRESHOLD=2            # 1 | 2 | 3

# --- SP-5: aislamiento de recursos (bulkhead) -------------------------------
# Que la saturación del perfilamiento no degrade la ruta Provider, que no
# depende de Open Finance. Hay dos frentes de saturación y ambos se miden.
BULKHEAD_ENABLED=true                    # ablación: false = sin semáforos
POOL_OPENFINANCE_MAX=8                   # 4 | 8 | 16   (salida en financial-profiler)
POOL_PENDING_REPLIES_MAX=16              # 8 | 16 | 32  (esperas de réplica en cotizacion)
POOL_PROVIDER_MAX=8                      # FIJO: es el control de SP-5, no una variable


# =============================================================================
# 2. VARIABLES DE CONTROL — fijas salvo instrucción explícita
# =============================================================================

QUOTE_MODE=treatment                     # treatment | baseline (baseline = control de SP-0)
CONSUMER_MODE=single_active              # single_active | competing (variante documentada §3.2)
MONITOR_TIMEOUT_MS=500
MONITOR_HEALTHY_THRESHOLD=2

JOURNEY_LATENCY_BUDGET_MS=250
REPLY_TIMEOUT_MS=900                     # derivado del presupuesto, no se sintoniza de forma
                                         # independiente; ver la descomposición de §7.1

# Concurrencia — deliberadamente baja para que la saturación sea observable en SP-5.
# El procesador-cotizacion es la excepción: usa 1 worker por diseño (ver README
# "Decisiones de implementación"), porque 2 workers registrarían dos consumidores
# AMQP por instancia y romperían la semántica PRIMARY/BACKUP de single-active-consumer.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=60

K6_RPS=50
K6_DURATION=240s


# =============================================================================
# 3. INFRAESTRUCTURA Y ENDPOINTS
# Ningún hostname ni puerto puede estar hardcodeado en el código (§5.3).
# Cambiar amqp://rabbitmq:5672 por el endpoint de Amazon MQ debe bastar (§8.2).
# =============================================================================

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://solventa:solventa@postgres:5432/solventa

RABBITMQ_URL=amqp://solventa:solventa@rabbitmq:5672/
RABBITMQ_MGMT_URL=http://rabbitmq:15672
EXCHANGE_QUOTES=solventa.quotes
QUEUE_REQUESTS=cotizacion.requests
EXCHANGE_EVENTS=solventa.events

COTIZACION_URL=http://cotizacion:8082
SOCIO_URL=http://socio-distribucion:8081
PROFILER_URL=http://financial-profiler:8085
OPENFINANCE_URL=http://mock-openfinance:8090

PROMETHEUS_URL=http://prometheus:9090

LOG_LEVEL=INFO
LOG_FORMAT=json

# Inyectadas por servicio en docker-compose.yml — no fijar aquí.
# SERVICE_NAME=
# PORT=
# ROLE=                                  # PRIMARY | BACKUP en procesador-cotizacion
